# SGCA - Configuration Environnement
# Copiez ce fichier en .env et modifiez les valeurs

# Django
SECRET_KEY=votre-cle-secrete-tres-longue-et-aleatoire-ici
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données PostgreSQL (recommandé pour production)
DB_NAME=sgca_ult
DB_USER=postgres
DB_PASSWORD=votre_mot_de_passe_postgres
DB_HOST=localhost
DB_PORT=5432

# Pour le développement sans PostgreSQL
USE_SQLITE=False

# Redis (pour Celery - tâches asynchrones)
REDIS_URL=redis://localhost:6379/0

# CORS - Origines autorisées (séparées par virgules)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
